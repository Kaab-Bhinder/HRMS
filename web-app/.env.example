# ---- App ----
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:4000/api/v1

# ---- Database ----
DATABASE_URL=postgresql://wms:wms@localhost:5432/wms

# ---- Redis (cache, queues, rate-limit) ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT (generate strong random values; use Secrets Manager in prod) ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ARGON2_MEMORY_COST=19456

# ---- Encryption (AES-256 for sensitive columns/custom fields) ----
DATA_ENCRYPTION_KEY=base64-32-byte-key

# ---- File storage (S3) ----
S3_BUCKET=wms-documents
S3_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=15

# ---- Notifications ----
SMTP_URL=
SMS_PROVIDER_KEY=
WHATSAPP_API_KEY=

# ---- Security ----
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120
CORS_ORIGINS=http://localhost:5173

# --- In-app assistant (optional) -------------------------------------------
# Tried in order; the first with a key leads, the rest are failover for
# outages, rate limits, and timeouts. A missing key disables that provider
# rather than breaking the chain. With none set, the assistant hides itself.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Third-line backup via OpenRouter (OpenAI-compatible).
# The model MUST support tool calling — the assistant answers by calling
# scoped tools, and a model without tool support will invent numbers instead
# of looking them up. Known-good: google/gemini-2.5-flash,
# openai/gpt-oss-120b, qwen/qwen3-235b-a22b. Avoid small "nano"/base models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Which vendor leads: openai | claude | openrouter
ASSISTANT_PROVIDER=openai

# --- Outgoing e-mail (invitations, password resets) ------------------------
# Any SMTP provider works — SES, Brevo, Postmark, Gmail. With SMTP_HOST unset
# nothing is sent: the message is logged instead and the set-password link is
# still returned to the caller, so invitations remain usable in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HR <no-reply@yourdomain.com>"

# Base URL of the WEB app — invitation links are built from this.
APP_URL=http://localhost:5173
