# ---- App ----
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:4000/api/v1

# ---- Database ----
DATABASE_URL=postgresql://wms:wms@localhost:5432/wms

# ---- Redis (cache, queues, rate-limit) ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT (generate strong random values; use Secrets Manager in prod) ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ARGON2_MEMORY_COST=19456

# ---- Encryption (AES-256 for sensitive columns/custom fields) ----
DATA_ENCRYPTION_KEY=base64-32-byte-key

# ---- File storage (S3) ----
S3_BUCKET=wms-documents
S3_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=15

# ---- Notifications ----
SMTP_URL=
SMS_PROVIDER_KEY=
WHATSAPP_API_KEY=

# ---- Security ----
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120
CORS_ORIGINS=http://localhost:5173
