# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173

# Database (Prisma)
DATABASE_URL=postgresql://wms:wms@localhost:5432/wms?schema=public

# JWT — generate strong random secrets (openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Auth cookie
COOKIE_SECRET=change-me-cookie-secret
REFRESH_COOKIE_NAME=wms_rt

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Seed super admin (used by prisma db seed)
SEED_ADMIN_EMAIL=admin@acmebank.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ORG_NAME=Acme Bank Ltd

# ── Object storage (files + check-in selfies) ────────────────────────────────
# Leave STORAGE_DRIVER unset (or "local") to store on local disk (default).
# Set STORAGE_DRIVER=s3 and fill the S3_* vars to use S3 / Cloudflare R2 / MinIO.
STORAGE_DRIVER=local
FILE_STORAGE_DIR=            # optional: local-disk path (defaults to ./storage/uploads)

# S3 / R2 / MinIO — used only when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=us-east-1         # AWS: e.g. ap-southeast-3 (Jakarta). Cloudflare R2: auto
S3_ENDPOINT=                # AWS: leave blank. R2: https://<acct>.r2.cloudflarestorage.com. MinIO: http://host:9000
S3_FORCE_PATH_STYLE=false   # true for MinIO / some R2 setups
S3_ACCESS_KEY_ID=           # NEVER commit real keys — keep them in .env only
S3_SECRET_ACCESS_KEY=
