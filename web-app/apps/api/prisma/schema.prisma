  running
  success
  failed
  partial
}

enum LeaveRequestStatus {
  draft
  pending
  approved
  rejected
  cancelled
  withdrawn
}

enum ApprovalStatus {
  pending
  approved
  rejected
  skipped
}

enum TaskStatus {
  backlog
  todo
  in_progress
  in_review
  blocked
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

// --- Shifts, roster, policies, calendar ---
model Shift {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  type           ShiftType @default(fixed)
  startTime      String    @map("start_time") @db.VarChar(5) // "HH:mm"
  endTime        String    @map("end_time") @db.VarChar(5)
  graceMinutes   Int       @default(0) @map("grace_minutes")
  breakMinutes   Int       @default(0) @map("break_minutes")
  workMinutes    Int?      @map("work_minutes")
  isNight        Boolean   @default(false) @map("is_night")
  isDefault      Boolean   @default(false) @map("is_default")
  // Site-specific office hours: a shift tagged to a location overrides the
  // default shift for days worked at that site (employee-assigned shifts
  // still win — most specific first). Mirrors AttendancePolicy.locationId.
  locationId     String?   @map("location_id") @db.Uuid
  breaks         Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  employeeShifts EmployeeShift[]

  @@index([organizationId])
  @@map("shifts")
}

model EmployeeShift {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  shiftId        String    @map("shift_id") @db.Uuid
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  weekdays       Int[]     @default([])
  createdAt      DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@map("employee_shifts")
}

model AttendancePolicy {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  name                 String    @db.VarChar(120)
  isDefault            Boolean   @default(false) @map("is_default")
  locationId           String?   @map("location_id") @db.Uuid
  graceMinutes         Int       @default(0) @map("grace_minutes")
  lateAfterMinutes     Int?      @map("late_after_minutes")
  earlyBeforeMinutes   Int?      @map("early_before_minutes")
  halfDayMinutes       Int?      @map("half_day_minutes")
  fullDayMinutes       Int?      @map("full_day_minutes")
  overtimeAfterMinutes Int?      @map("overtime_after_minutes")
  // What an out-of-site check-in costs: nothing / a flag / the whole day.
  offSiteCheckIn       OffSitePolicy @default(flag) @map("off_site_check_in")
  // any_site: validate against the nearest active work site the employee is
  // inside. assigned_only: an employee WITH an assigned site must be inside
  // that one; unassigned employees fall back to nearest-site so a fresh
  // rollout never flags the whole workforce.
  checkInScope         CheckInScope @default(any_site) @map("check_in_scope")
  // Face mismatch stays a boolean: unlike location there is no sensible
  // "allowed" level — not enrolling is how you opt out of face matching.
  absentOnFaceMismatch Boolean      @default(false) @map("absent_on_face_mismatch")
  allowedMethods       String[]  @default([]) @map("allowed_methods")
  weeklyOffDays        Int[]     @default([0, 6]) @map("weekly_off_days")
  trackingIntervalSec  Int       @default(120) @map("tracking_interval_sec")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  @@index([organizationId])
  @@map("attendance_policies")
}

model Holiday {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  name           String   @db.VarChar(120)
  date           DateTime @db.Date
  isOptional     Boolean  @default(false) @map("is_optional")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, date])
  @@map("holidays")
}

// --- Attendance capture (two-layer: raw punches + derived day) ---
model AttendancePunch {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  sessionId       String?          @map("session_id") @db.Uuid
  type            PunchType
  method          AttendanceMethod
  occurredAt      DateTime         @map("occurred_at")
  locationId      String?          @map("location_id") @db.Uuid
  latitude        Decimal?         @db.Decimal(9, 6)
  longitude       Decimal?         @db.Decimal(9, 6)
  accuracyMeters  Int?             @map("accuracy_meters")
  faceCaptureId   String?          @map("face_capture_id") @db.Uuid
  deviceId        String?          @map("device_id") @db.Uuid
  deviceLogId     String?          @map("device_log_id") @db.VarChar(80)
  isOffline       Boolean          @default(false) @map("is_offline")
  clientCreatedAt DateTime?        @map("client_created_at")
  syncedAt        DateTime?        @map("synced_at")
  rawPayload      Json?            @map("raw_payload")
  createdById     String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")

  session AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([deviceId, deviceLogId])
  @@index([employeeId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("attendance_punches")
}

model AttendanceDay {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  employeeId        String              @map("employee_id") @db.Uuid
  workDate          DateTime            @map("work_date") @db.Date
  shiftId           String?             @map("shift_id") @db.Uuid
  policyId          String?             @map("policy_id") @db.Uuid
  // Work site of the day's first geofence-resolved check-in — "where they
  // worked", the number outsourcing billing and branch reports read.
  locationId        String?             @map("location_id") @db.Uuid
  firstInAt         DateTime?           @map("first_in_at")
  lastOutAt         DateTime?           @map("last_out_at")
  status            AttendanceDayStatus @default(absent)
  workedMinutes     Int                 @default(0) @map("worked_minutes")
  breakMinutes      Int                 @default(0) @map("break_minutes")
  overtimeMinutes   Int                 @default(0) @map("overtime_minutes")
  lateMinutes       Int                 @default(0) @map("late_minutes")
  earlyLeaveMinutes Int                 @default(0) @map("early_leave_minutes")
  isRegularized     Boolean             @default(false) @map("is_regularized")
  isFlagged         Boolean             @default(false) @map("is_flagged")
  flagReason        String?             @map("flag_reason")
  primaryMethod     AttendanceMethod?   @map("primary_method")
  note              String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@index([organizationId, workDate])
  @@index([organizationId, isFlagged])
  @@map("attendance_days")
}

model AttendanceRegularization {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  employeeId     String         @map("employee_id") @db.Uuid
  workDate       DateTime       @map("work_date") @db.Date
  reason         String
  requestedInAt  DateTime?      @map("requested_in_at")
  requestedOutAt DateTime?      @map("requested_out_at")
  status         ApprovalStatus @default(pending)
  reviewedById   String?        @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?      @map("reviewed_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([organizationId, status])
  @@map("attendance_regularizations")
}

// --- Live location tracking ---
model AttendanceSession {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  employeeId        String        @map("employee_id") @db.Uuid
  workDate          DateTime?     @map("work_date") @db.Date
  status            SessionStatus @default(active)
