// Operational source of truth for the DB (Prisma-managed migrations).
// Mirrors db/schema.sql. Models are added phase by phase; this is Phase 0–1
// (auth + RBAC). Phase 2+ models (employees, attendance, tasks…) append here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  invited
  active
  suspended
  disabled
}

model Organization {
  id                      String           @id @default(uuid()) @db.Uuid
  name                    String           @db.VarChar(200)
  legalName               String?          @map("legal_name") @db.VarChar(255)
  slug                    String           @unique
  logoUrl                 String?          @map("logo_url")
  timezone                String           @default("UTC") @db.VarChar(64)
  /// Domain work e-mails are built from, e.g. "bankmas.co.id". When unset the
  /// system infers it from existing employees rather than guessing.
  emailDomain             String?          @map("email_domain") @db.VarChar(120)
  locale                  String           @default("en") @db.VarChar(16)
  currency                String           @default("USD") @db.Char(3)
  // Org-wide default pay model, chosen at setup. New employees inherit it as
  // their compensationType; it's a default, not a hard org lock.
  defaultCompensationType CompensationType @default(hourly) @map("default_compensation_type")
  settings                Json             @default("{}")
  isActive                Boolean          @default(true) @map("is_active")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  deletedAt               DateTime?        @map("deleted_at")

  users        User[]
  roles        Role[]
  locations    Location[]
  departments  Department[]
  designations Designation[]
  employees    Employee[]
  customFields CustomFieldDefinition[]
  files        FileObject[]
  clients      Client[]
  assets       Asset[]

  @@map("organizations")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  email             String     @db.VarChar(255)
  passwordHash      String?    @map("password_hash")
  fullName          String     @map("full_name") @db.VarChar(150)
  avatarUrl         String?    @map("avatar_url")
  status            UserStatus @default(invited)
  isSuperAdmin      Boolean    @default(false) @map("is_super_admin")
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  mfaSecret         String?    @map("mfa_secret")
  lastLoginAt       DateTime?  @map("last_login_at")
  failedAttempts    Int        @default(0) @map("failed_attempts") @db.SmallInt
  lockedUntil       DateTime?  @map("locked_until")
  passwordChangedAt DateTime?  @map("password_changed_at")
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  employee      Employee?

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
  accountTokens AccountToken[]
}

model Role {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(80)
  slug            String    @db.VarChar(80)
  description     String?
  isSystem        Boolean   @default(false) @map("is_system")
  // Platform access is a separate axis from permissions (an auth-time gate, not
  // an in-app grant). A user's allowed platforms = union of their roles' flags.
  canAccessWeb    Boolean   @default(false) @map("can_access_web")
  canAccessMobile Boolean   @default(false) @map("can_access_mobile")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, slug])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(100)
  resource    String  @db.VarChar(60)
  action      String  @db.VarChar(40)
  description String?

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  platform   String    @default("web") @db.VarChar(20) // the app this session was opened from
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
//  PHASE 2 — Organization & People
// ============================================================================

enum EmployeeStatus {
  probation
  active
  on_leave
  suspended
  resigned
  terminated
  retired
}

enum EmploymentType {
  full_time
  part_time
  contract
  intern
  consultant
}

enum Gender {
  male
  female
  other
  undisclosed
}

enum CompensationType {
  monthly
  hourly
}

enum CheckInScope {
  any_site
  assigned_only
}

/// What happens when someone checks in outside every allowed work site.
/// One setting replaces the old enforceGeofence/allowRemote/absentOnGeofenceFail
/// trio, which encoded the same decision three times and allowed
/// self-contradictory combinations.
enum OffSitePolicy {
  allowed // never flagged — the site's geofence is advisory
  flag    // recorded and flagged for HR review (default)
  absent  // the day is marked absent (still flagged, with the reason)
}

enum CustomFieldType {
  text
  textarea
  number
  decimal
  boolean
  date
  datetime
  email
  phone
  url
  select
  multiselect
  file
  json
}

enum CustomFieldEntity {
  employee
  department
  task
  asset
  document
  organization
  leave_request
}

model Location {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(150)
  address        String?
  latitude       Decimal?  @db.Decimal(9, 6)
  longitude      Decimal?  @db.Decimal(9, 6)
  radiusMeters   Int?      @map("radius_meters")
  timezone       String?   @db.VarChar(64)
  isActive       Boolean   @default(true) @map("is_active")
  isDefault      Boolean   @default(false) @map("is_default")
  // A work site is either the org's own branch (clientId null) or a CLIENT's
  // premises where outsourced staff clock in. One geofence table for both —
  // attendance code never needs to know who owns the site.
  clientId       String?   @map("client_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation("ClientSites", fields: [clientId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@index([organizationId])
  @@index([clientId])
  @@map("locations")
}

model Department {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String    @db.VarChar(150)
  code           String?   @db.VarChar(40)
  description    String?
  headEmployeeId String?   @map("head_employee_id") @db.Uuid
  costCenter     String?   @map("cost_center") @db.VarChar(60)
  customFields   Json      @default("{}") @map("custom_fields")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdById    String?   @map("created_by") @db.Uuid
  updatedById    String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DeptTree")
  head         Employee?    @relation("DeptHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  members      Employee[]   @relation("DeptMembers")
  tasks        Task[]
  clients      Client[]     @relation("ClientDept")

  @@index([organizationId])
  @@index([parentId])
  @@map("departments")
}

enum AssetStatus {
  available
  assigned
  in_repair
  lost
  retired
}

/// Physical/digital company property. The registry row carries identity and
/// purchase facts; `assignedToId` denormalizes the CURRENT holder for fast
/// lists, while AssetAssignment keeps the full issue/return audit trail —
/// that history (not the current pointer) is what offboarding clearance and
/// audits rely on. Status discipline: only an `available` asset can be
/// assigned; a return states the condition and where the asset goes next.
model Asset {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  assetTag       String      @map("asset_tag") @db.VarChar(60)
  name           String      @db.VarChar(200)
  category       String      @db.VarChar(60)
  serialNumber   String?     @map("serial_number") @db.VarChar(120)
  purchaseDate   DateTime?   @map("purchase_date") @db.Date
  purchaseCost   Decimal?    @map("purchase_cost") @db.Decimal(14, 2)
  vendor         String?     @db.VarChar(150)
  warrantyUntil  DateTime?   @map("warranty_until") @db.Date
  status         AssetStatus @default(available)
  condition      String?     @db.VarChar(40)
  notes          String?
  customFields   Json        @default("{}") @map("custom_fields")
  assignedToId   String?     @map("assigned_to") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  createdById    String?     @map("created_by") @db.Uuid
  updatedById    String?     @map("updated_by") @db.Uuid
  deletedAt      DateTime?   @map("deleted_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   Employee?         @relation("AssetHolder", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignments  AssetAssignment[]

  @@unique([organizationId, assetTag])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@map("assets")
}

/// One issue→return cycle of an asset. `returnedAt IS NULL` = currently out.
model AssetAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  assignedById   String?   @map("assigned_by") @db.Uuid
  conditionOut   String?   @map("condition_out") @db.VarChar(40)
  returnedAt     DateTime? @map("returned_at")
  returnedById   String?   @map("returned_by") @db.Uuid
  conditionIn    String?   @map("condition_in") @db.VarChar(40)
  notes          String?

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee Employee @relation("AssetAssignments", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([assetId, assignedAt])
  @@index([employeeId, returnedAt])
  @@map("asset_assignments")
}

enum ClientStatus {
  prospect
  active
  inactive
}

/// A company the organization serves. Clients get NO login and no platform
/// access — this is an admin-side record. Each client is served by one
/// department (its head is the de-facto account lead); several clients may
/// share a department, and internal departments simply have no client.
/// Admin visibility (attendance, tasks, roster "for this client") is derived
/// live from the linked department — nothing is duplicated onto the client.
model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(200)
  code           String?      @db.VarChar(40)
  contactPerson  String?      @map("contact_person") @db.VarChar(150)
  contactEmail   String?      @map("contact_email") @db.VarChar(255)
  contactPhone   String?      @map("contact_phone") @db.VarChar(30)
  status         ClientStatus @default(active)
  notes          String?
  departmentId   String?      @map("department_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdById    String?      @map("created_by") @db.Uuid
  updatedById    String?      @map("updated_by") @db.Uuid
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?     @relation("ClientDept", fields: [departmentId], references: [id], onDelete: SetNull)
  sites        Location[]      @relation("ClientSites")

  @@index([organizationId, status])
  @@index([departmentId])
  @@map("clients")
  travelRequests TravelRequest[]
}

model Designation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  title          String    @db.VarChar(150)
  level          Int?
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, title])
  @@map("designations")
}

model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  userId           String?          @unique @map("user_id") @db.Uuid
  employeeCode     String           @map("employee_code") @db.VarChar(40)
  firstName        String           @map("first_name") @db.VarChar(80)
  lastName         String           @map("last_name") @db.VarChar(80)
  displayName      String?          @map("display_name") @db.VarChar(160)
  workEmail        String?          @map("work_email") @db.VarChar(255)
  // Profile photo, stored as a FileObject id (served through the authenticated
  // /files/:id/download endpoint — never a public URL).
  photoFileId      String?          @map("photo_file_id") @db.Uuid
  personalEmail    String?          @map("personal_email") @db.VarChar(255)
  phone            String?          @db.VarChar(30)
  gender           Gender?
  dateOfBirth      DateTime?        @map("date_of_birth") @db.Date
  departmentId     String?          @map("department_id") @db.Uuid
  designationId    String?          @map("designation_id") @db.Uuid
  locationId       String?          @map("location_id") @db.Uuid
  managerId        String?          @map("manager_id") @db.Uuid
  employmentType   EmploymentType   @default(full_time) @map("employment_type")
  status           EmployeeStatus   @default(probation)
  dateOfJoining    DateTime?        @map("date_of_joining") @db.Date
  probationEnd     DateTime?        @map("probation_end") @db.Date
  dateOfExit       DateTime?        @map("date_of_exit") @db.Date
  // Compensation. `compensationType` decides which amount is authoritative:
  //   monthly → basicSalary is paid; hourly → payPerHour × attendance.
  // It defaults to the org's default at creation but can be overridden per
  // employee. Changing it only affects future (unfinalized) payroll runs —
  // finalized months are frozen as Payslip snapshots, so history never moves.
  compensationType CompensationType @default(hourly) @map("compensation_type")
  basicSalary      Decimal?         @map("basic_salary") @db.Decimal(14, 2)
  payPerHour       Decimal?         @map("pay_per_hour") @db.Decimal(10, 2)
  customFields     Json             @default("{}") @map("custom_fields")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  createdById      String?          @map("created_by") @db.Uuid
  updatedById      String?          @map("updated_by") @db.Uuid
  deletedAt        DateTime?        @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  department         Department?         @relation("DeptMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  designation        Designation?        @relation(fields: [designationId], references: [id], onDelete: SetNull)
  location           Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  manager            Employee?           @relation("EmpManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports            Employee[]          @relation("EmpManager")
  headOf             Department[]        @relation("DeptHead")
  history            EmploymentHistory[]
  employeeShifts     EmployeeShift[]
  attendanceDays     AttendanceDay[]
  attendanceSessions AttendanceSession[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  faceTemplates      FaceTemplate[]
  taskAssignments    TaskAssignment[]
  performanceReviews PerformanceReview[]
  goals              Goal[]
  payslips           Payslip[]
  heldAssets         Asset[]             @relation("AssetHolder")
  assetAssignments   AssetAssignment[]   @relation("AssetAssignments")

  @@unique([organizationId, employeeCode])
  // NOTE: uniqueness of workEmail is a PARTIAL index (only where deletedAt IS
  // NULL) created in migration 13 — Prisma cannot express that, so it is not
  // declared here. A soft-deleted employee must release their address so the
  // person can be re-hired.
  @@index([organizationId, status])
  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
  travelRequests TravelRequest[]
}

/// Immutable snapshot of one employee's pay for one finalized month. Written
/// when payroll is finalized; never recomputed. This is what keeps past months
/// stable when an employee's salary or compensation type later changes.
/// `breakdown` stores the full computed figures (basic, deductions, days, rate)
/// as JSON so a payslip can be re-rendered exactly as it was finalized.
model Payslip {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  year              Int              @db.SmallInt
  month             Int              @db.SmallInt
  compensationType  CompensationType @map("compensation_type")
  currency          String           @db.Char(3)
  grossAmount       Decimal          @map("gross_amount") @db.Decimal(14, 2)
  deductions        Decimal          @default(0) @db.Decimal(14, 2)
  netAmount         Decimal          @map("net_amount") @db.Decimal(14, 2)
  workingDays       Int              @map("working_days") @db.SmallInt
  paidDays          Decimal          @default(0) @map("paid_days") @db.Decimal(5, 2)
  unpaidLeaveDays   Decimal          @default(0) @map("unpaid_leave_days") @db.Decimal(5, 2)
  breakdown         Json             @default("{}")
  finalizedByUserId String?          @map("finalized_by_user") @db.Uuid
  finalizedByName   String?          @map("finalized_by_name") @db.VarChar(150)
  finalizedAt       DateTime         @default(now()) @map("finalized_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, month])
  @@index([organizationId, year, month])
  @@map("payslips")
}

model EmploymentHistory {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(40)
  fromValue     Json?    @map("from_value")
  toValue       Json?    @map("to_value")
  effectiveDate DateTime @map("effective_date") @db.Date
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  createdById   String?  @map("created_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employment_history")
}

model CustomFieldDefinition {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  entity         CustomFieldEntity
  fieldKey       String            @map("field_key") @db.VarChar(64)
  label          String            @db.VarChar(120)
  dataType       CustomFieldType   @map("data_type")
  helpText       String?           @map("help_text")
  placeholder    String?           @db.VarChar(160)
  defaultValue   Json?             @map("default_value")
  isRequired     Boolean           @default(false) @map("is_required")
  isUnique       Boolean           @default(false) @map("is_unique")
  minValue       Decimal?          @map("min_value") @db.Decimal
  maxValue       Decimal?          @map("max_value") @db.Decimal
  minLength      Int?              @map("min_length")
  maxLength      Int?              @map("max_length")
  regexPattern   String?           @map("regex_pattern")
  options        Json?
  displayOrder   Int               @default(0) @map("display_order")
  isVisible      Boolean           @default(true) @map("is_visible")
  isSearchable   Boolean           @default(false) @map("is_searchable")
  isFilterable   Boolean           @default(false) @map("is_filterable")
  isEncrypted    Boolean           @default(false) @map("is_encrypted")
  isSystem       Boolean           @default(false) @map("is_system")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entity, fieldKey])
  @@index([organizationId, entity])
  @@map("custom_field_definitions")
}

model FileObject {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ownerType      String    @map("owner_type") @db.VarChar(40)
  ownerId        String    @map("owner_id") @db.Uuid
  category       String?   @db.VarChar(60)
  fileName       String    @map("file_name") @db.VarChar(255)
  mimeType       String    @map("mime_type") @db.VarChar(120)
  sizeBytes      BigInt    @map("size_bytes")
  storageKey     String    @map("storage_key")
  checksumSha256 String?   @map("checksum_sha256") @db.Char(64)
  isScanned      Boolean   @default(false) @map("is_scanned")
  scanResult     String?   @map("scan_result") @db.VarChar(20)
  expiresOn      DateTime? @map("expires_on") @db.Date
  uploadedById   String?   @map("uploaded_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([ownerType, ownerId])
  @@map("files")
}

// ============================================================================
//  PHASE 3 — Time & Work (Attendance, Leave, Approvals, Tasks)
// ============================================================================

enum ShiftType {
  fixed
  flexible
  rotating
  overnight
}

enum AttendanceMethod {
  manual
  web
  mobile_gps
  mobile_face
  qr
  biometric
  kiosk
}

enum PunchType {
  check_in
  check_out
  break_start
  break_end
}

enum AttendanceDayStatus {
  present
  absent
  late
  half_day
  on_leave
  holiday
  weekly_off
  wfh
}

enum SessionStatus {
  active
  ended
  expired
}

enum DeviceConnectionType {
  push
  pull
  api
  sdk
  file
}

