enum ReportPeriodType {
  weekly
  monthly
  quarterly
}

enum ReportStatus {
  submitted
  reviewed
  acknowledged
}

/// A periodic work report submitted up the chain (dept head → HR → super admin).
/// Denormalizes submitter/department names so a submission is a stable record.
model Report {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  title             String           @db.VarChar(200)
  periodType        ReportPeriodType @map("period_type")
  periodStart       DateTime         @map("period_start") @db.Date
  periodEnd         DateTime         @map("period_end") @db.Date
  periodLabel       String?          @map("period_label") @db.VarChar(80)
  summary           String
  attachments       Json             @default("[]") // [{fileName, storageKey, sizeBytes, mimeType}] — wired with storage
  status            ReportStatus     @default(submitted)
  departmentId      String?          @map("department_id") @db.Uuid
  departmentName    String?          @map("department_name") @db.VarChar(150)
  submittedByUserId String           @map("submitted_by_user") @db.Uuid
  submittedByEmpId  String?          @map("submitted_by_emp") @db.Uuid
  submitterName     String           @map("submitter_name") @db.VarChar(150)
  submitterView     String           @map("submitter_view") @db.VarChar(20) // dept_head | hr | admin
  submittedAt       DateTime         @default(now()) @map("submitted_at")
  reviewedByUserId  String?          @map("reviewed_by_user") @db.Uuid
  reviewedByName    String?          @map("reviewed_by_name") @db.VarChar(150)
  reviewedAt        DateTime?        @map("reviewed_at")
  reviewNote        String?          @map("review_note")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  @@index([organizationId, periodStart])
  @@index([organizationId, submittedByUserId])
  @@map("reports")
}

enum AgreementStatus {
  draft
  sent
  partially_signed
  completed
  declined
  cancelled
}

enum SignerStatus {
  pending
  viewed
  signed
  declined
}

/// A reusable agreement body owned by the administrator. `{{name}}`,
/// `{{date}}` and `{{company}}` are substituted when an agreement is raised.
model AgreementTemplate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(150)
  body           String
  isActive       Boolean   @default(true) @map("is_active")
  createdById    String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  agreements Agreement[]

  @@index([organizationId, isActive])
  @@map("agreement_templates")
}

/// One document out for signature. `body` is a SNAPSHOT taken when the
/// agreement is raised — editing the template afterwards must never change what
/// somebody already signed.
model Agreement {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  templateId     String?         @map("template_id") @db.Uuid
  title          String          @db.VarChar(200)
  body           String
  status         AgreementStatus @default(draft)
  /// SHA-256 of the body, fixed at creation. Proves the text a signer accepted
  /// is the text stored now.
  bodyHash       String          @map("body_hash") @db.VarChar(64)

  createdByUserId String    @map("created_by_user") @db.Uuid
  createdByName   String    @map("created_by_name") @db.VarChar(150)
  sentAt          DateTime? @map("sent_at")
  completedAt     DateTime? @map("completed_at")
  expiresAt       DateTime? @map("expires_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  template AgreementTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  signers  AgreementSigner[]

  @@index([organizationId, status])
  @@map("agreements")
}

/// A person who must sign, and the audit trail of their doing so. The link they
/// receive is a random token stored only as a hash, so a database read cannot be
/// turned back into a working signing URL.
model AgreementSigner {
  id             String  @id @default(uuid()) @db.Uuid
  agreementId    String  @map("agreement_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(150)
  phone          String? @db.VarChar(30)
  email          String? @db.VarChar(255)
  employeeId     String? @map("employee_id") @db.Uuid
  orderIndex     Int     @default(0) @map("order_index") @db.SmallInt

  status    SignerStatus @default(pending)
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")

  viewedAt      DateTime? @map("viewed_at")
  signedAt      DateTime? @map("signed_at")
  declinedAt    DateTime? @map("declined_at")
  declineReason String?   @map("decline_reason")

  /// The captured signature, background already removed, as a transparent PNG.
  /// Kept inline rather than in file storage: a few kilobytes that must never
  /// become separable from the record they authenticate.
  signaturePng    Bytes?  @map("signature_png")
  signedIp        String? @map("signed_ip") @db.VarChar(60)
  signedUserAgent String? @map("signed_user_agent") @db.VarChar(300)

  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId, orderIndex])
  @@index([organizationId, status])
  @@map("agreement_signers")
}

enum MemoRecipientKind {
  /// Chosen by the sender.
  to
  /// Added automatically so management can see what moves between departments.
  oversight
}

/// A memo sent from one person to another anywhere in the organisation —
/// sideways between departments, not only up the reporting line the way
/// `Report` travels. Sender and department names are denormalized so the record
/// still reads correctly after a transfer or a rename.
model Memo {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  subject        String  @db.VarChar(200)
  body           String
  attachments    Json    @default("[]") // [{fileId, fileName, sizeBytes, mimeType}]
  senderUserId   String  @map("sender_user") @db.Uuid
  senderEmpId    String? @map("sender_emp") @db.Uuid
  senderName     String  @map("sender_name") @db.VarChar(150)
  senderDeptId   String? @map("sender_dept") @db.Uuid
  senderDeptName String? @map("sender_dept_name") @db.VarChar(150)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  recipients MemoRecipient[]

  @@index([organizationId, createdAt])
  @@index([organizationId, senderUserId])
  @@map("memos")
}

/// One row per person a memo reached. Read state lives here rather than on the
/// memo, so a memo read by its recipient is still unread for the oversight copy.
model MemoRecipient {
  id             String            @id @default(uuid()) @db.Uuid
  memoId         String            @map("memo_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  employeeId     String?           @map("employee_id") @db.Uuid
  name           String            @db.VarChar(150)
  departmentName String?           @map("department_name") @db.VarChar(150)
  kind           MemoRecipientKind @default(to)
  readAt         DateTime?         @map("read_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  memo Memo @relation(fields: [memoId], references: [id], onDelete: Cascade)

  /// Someone who is both a chosen recipient and an oversight copy gets one row,
  /// not two — the direct role wins.
  @@unique([memoId, userId])
  @@index([organizationId, userId, readAt])
  @@map("memo_recipients")
}

// ============================================================================
//  PHASE 4 — Performance, Notifications, Reports, Analytics, Audit, Settings
// ============================================================================

enum NotificationChannel {
  in_app
  email
  sms
  push
  whatsapp
}

enum NotificationStatus {
  queued
  sent
  delivered
  read
  failed
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}

enum ReviewStatus {
  draft
  in_progress
  submitted
  acknowledged
  closed
}

enum GoalStatus {
  not_started
  on_track
  at_risk
  off_track
  completed
  cancelled
}

enum AuditAction {
  create
  read
  update
  delete
  restore
  login
  logout
  export
  approve
  reject
  assign
}

// --- Notifications (multi-channel) ---
model NotificationTemplate {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  eventKey       String               @map("event_key") @db.VarChar(80)
  channel        NotificationChannel
  locale         String               @default("en") @db.VarChar(8) // language-neutral backend; content keyed by locale
  subject        String?              @db.VarChar(200)
  body           String
  priority       NotificationPriority @default(normal)
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId, eventKey, channel, locale])
  @@map("notification_templates")
}

model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  recipientUserId String               @map("recipient_user_id") @db.Uuid
  eventKey        String?              @map("event_key") @db.VarChar(80)
  category        String?              @db.VarChar(40)
  priority        NotificationPriority @default(normal)
  title           String               @db.VarChar(200)
  body            String?
  data            Json                 @default("{}")
  scheduledAt     DateTime?            @map("scheduled_at")
  readAt          DateTime?            @map("read_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  deliveries NotificationDeliveryLog[]

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

model NotificationDeliveryLog {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  notificationId String?             @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationStatus  @default(queued)
  providerRef    String?             @map("provider_ref") @db.VarChar(160)
  error          String?
  attemptedAt    DateTime            @default(now()) @map("attempted_at")

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([organizationId, channel, status])
  @@map("notification_delivery_logs")
}

model NotificationPreference {
  userId    String              @map("user_id") @db.Uuid
  eventKey  String              @map("event_key") @db.VarChar(80)
  channel   NotificationChannel
  isEnabled Boolean             @default(true) @map("is_enabled")

  @@id([userId, eventKey, channel])
  @@map("notification_preferences")
}

// --- Performance ---
model ReviewCycle {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(120)
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  reviews PerformanceReview[]

  @@map("review_cycles")
}

model PerformanceReview {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  cycleId        String?      @map("cycle_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  reviewerId     String?      @map("reviewer_id") @db.Uuid
  status         ReviewStatus @default(draft)
  overallScore   Decimal?     @map("overall_score") @db.Decimal(4, 2)
  summary        String?
  submittedAt    DateTime?    @map("submitted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  cycle    ReviewCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([employeeId])
  @@map("performance_reviews")
}

model Goal {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  employeeId     String?    @map("employee_id") @db.Uuid
  departmentId   String?    @map("department_id") @db.Uuid
  title          String     @db.VarChar(200)
  metric         String?    @db.VarChar(120)
  targetValue    Decimal?   @map("target_value") @db.Decimal(14, 2)
  currentValue   Decimal?   @map("current_value") @db.Decimal(14, 2)
  weight         Decimal?   @db.Decimal(5, 2)
  status         GoalStatus @default(not_started)
  dueDate        DateTime?  @map("due_date") @db.Date
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("goals")
}

// --- Reports ---
model SavedReport {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(150)
  module         String    @db.VarChar(60)
  definition     Json
  scheduleCron   String?   @map("schedule_cron") @db.VarChar(60)
  recipients     Json?
  createdById    String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@index([organizationId, module])
  @@map("saved_reports")
}

// --- Audit & Activity ---
model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  actorUserId    String?     @map("actor_user_id") @db.Uuid
  actorName      String?     @map("actor_name") @db.VarChar(150)
  action         AuditAction
  entityType     String      @map("entity_type") @db.VarChar(60)
  entityId       String?     @map("entity_id") @db.VarChar(80)
  beforeData     Json?       @map("before_data")
  afterData      Json?       @map("after_data")
  ipAddress      String?     @map("ip_address") @db.VarChar(64)
  userAgent      String?     @map("user_agent")
  requestId      String?     @map("request_id") @db.VarChar(80)
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorName      String?  @map("actor_name") @db.VarChar(150)
  verb           String   @db.VarChar(60)
  summary        String
  entityType     String?  @map("entity_type") @db.VarChar(60)
  entityId       String?  @map("entity_id") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("activity_logs")
}

// --- Settings (modular key/value) ---
model Setting {
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(120)
  value          Json
  updatedById    String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([organizationId, key])
  @@map("settings")
}

// ---------------------------------------------------------------------------
// Business travel: request -> approval -> advance -> realization -> settlement
// ---------------------------------------------------------------------------

enum TravelStatus {
  draft
  submitted            // waiting on the approval chain
  approved             // chain cleared; advance may be paid
  rejected
  advance_paid
  realization_submitted // employee filed the accountability report
  verified             // finance checked the report
  completed            // settled and paid out / recovered
  cancelled
}

enum TransportMode {
  flight
  train
  car
  bus
  other
}

/// Finance's verdict on the accountability report.
enum TravelVerification {
  approved
  partially_approved
  rejected
}

/// Which role fills a step of the approval chain, resolved per employee.
enum TravelApprover {
  supervisor
  department_head
  finance
}

model TravelRequest {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  reference      String   @db.VarChar(40)

  // --- Step 1: the request
  destinationCity String        @map("destination_city") @db.VarChar(160)
  clientId        String?       @map("client_id") @db.Uuid
  clientName      String?       @map("client_name") @db.VarChar(200)
  purpose         String
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime      @map("end_date") @db.Date
  transportation  TransportMode
  hotelNeeded     Boolean       @default(false) @map("hotel_needed")
  estimatedCost   Decimal       @default(0) @map("estimated_cost") @db.Decimal(14, 2)

  status TravelStatus @default(draft)

  // --- Step 3: advance. "requested" is what the employee asked for;
  // "approved" is what finance actually released, which may be lower.
  requestedTransport Decimal @default(0) @map("requested_transport") @db.Decimal(14, 2)
  requestedHotel     Decimal @default(0) @map("requested_hotel") @db.Decimal(14, 2)
  requestedAllowance Decimal @default(0) @map("requested_allowance") @db.Decimal(14, 2)
  approvedTransport  Decimal @default(0) @map("approved_transport") @db.Decimal(14, 2)
  approvedHotel      Decimal @default(0) @map("approved_hotel") @db.Decimal(14, 2)
  approvedAllowance  Decimal @default(0) @map("approved_allowance") @db.Decimal(14, 2)
  advanceNote        String? @map("advance_note")
  advancePaidAt      DateTime? @map("advance_paid_at")
  advancePaymentRef  String?   @map("advance_payment_ref") @db.VarChar(120)

  // --- Step 4: realization (what actually happened)
  actualDepartureDate   DateTime? @map("actual_departure_date") @db.Date
  actualReturnDate      DateTime? @map("actual_return_date") @db.Date
  transportUsed         String?   @map("transport_used") @db.VarChar(200)
  hotelUsed             String?   @map("hotel_used") @db.VarChar(200)
  actualTransport       Decimal   @default(0) @map("actual_transport") @db.Decimal(14, 2)
  actualHotel           Decimal   @default(0) @map("actual_hotel") @db.Decimal(14, 2)
  actualAllowance       Decimal   @default(0) @map("actual_allowance") @db.Decimal(14, 2)
  realizationNote       String?   @map("realization_note")
  realizationSubmittedAt DateTime? @map("realization_submitted_at")

  // --- Step 5: finance verification
  verification      TravelVerification?
  verifiedAmount    Decimal?  @map("verified_amount") @db.Decimal(14, 2)
  verificationNote  String?   @map("verification_note")
  verifiedByUserId  String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt        DateTime? @map("verified_at")

  // --- Settlement. Positive => the company still owes the employee;
  // negative => the employee must return unspent advance. Frozen at
  // verification so later edits cannot silently change what was paid.
  settlementAmount    Decimal?  @map("settlement_amount") @db.Decimal(14, 2)
  settlementPaidAt    DateTime? @map("settlement_paid_at")
  settlementPaymentRef String?  @map("settlement_payment_ref") @db.VarChar(120)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  client     Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  activities TravelActivity[]
  evidence   TravelEvidence[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([employeeId, startDate])
  @@map("travel_requests")
}

/// One line of the day-by-day activity log on the accountability report.
model TravelActivity {
  id              String   @id @default(uuid()) @db.Uuid
  travelRequestId String   @map("travel_request_id") @db.Uuid
  activityDate    DateTime @map("activity_date") @db.Date
  timeLabel       String   @map("time_label") @db.VarChar(20)
  description     String
  createdAt       DateTime @default(now()) @map("created_at")

  request TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)

  @@index([travelRequestId, activityDate])
  @@map("travel_activities")
}

/// Supporting document attached to the accountability report.
model TravelEvidence {
  id              String   @id @default(uuid()) @db.Uuid
  travelRequestId String   @map("travel_request_id") @db.Uuid
  fileId          String   @map("file_id") @db.Uuid
  caption         String?  @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at")

  request TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)

  @@index([travelRequestId])
  @@map("travel_evidence")
}

///
/// Who approves, by seniority. The chain varies with position level, so it is
/// data rather than code: a rule matches a designation level range and lists
/// the approver roles in order.
model TravelApprovalRule {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String          @db.VarChar(120)
  minLevel       Int             @default(0) @map("min_level")
  maxLevel       Int             @default(999) @map("max_level")
  steps          TravelApprover[]
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([organizationId, isActive])
  @@map("travel_approval_rules")
}

/// Why an account-setup link was issued — the same single-use token mechanism
/// serves a first-time invitation and a later "forgot password".
enum AccountTokenPurpose {
  invite
  reset
}

/// A single-use, expiring link that lets someone set their own password.
/// Only a HASH is stored: a leaked database row cannot be redeemed, exactly
/// like refresh tokens.
model AccountToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  tokenHash String              @unique @map("token_hash")
  purpose   AccountTokenPurpose @default(invite)
  expiresAt DateTime            @map("expires_at")
  usedAt    DateTime?           @map("used_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("account_tokens")
}
